<bblocks://ogc.bbr.template.records-prov> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Record with Provenance" ;
    dct:abstract "AOGC API Record item with a provenance trace supporting the PROV-O model and DAG (directed acyclic graph) through both object nesting and references"^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2023-12-08T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-records-prov-dq/bblock/ogc.bbr.template.records-prov> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-records-prov-dq/build/generateddocs/markdown/bbr/template/records-prov/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-records-prov-dq/build/generateddocs/json-full/bbr/template/records-prov/index.json> ] ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-09-16"^^xsd:date ;
    dct:source <https://www.w3.org/TR/prov-o/> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-records-prov-dq/> ;
    skos:prefLabel "Record with Provenance" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-records-prov-dq/> ;
    dcat:keyword "item",
        "provenance",
        "stac" ;
    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-records-prov-dq/build/annotated/bbr/template/records-prov/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.geo.features.feature> ;
            prof:hasArtifact <https://opengeospatial.github.io/bblocks/registereditems/geo/features/feature/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.api.records.v1.schemas.linkTemplate> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-ogcapi-records/_sources/v1/schemas/linkTemplate/rules.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-records-prov-dq/build/annotated/bbr/template/records-prov/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-records-prov-dq/build/annotated/bbr/template/records-prov/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.cross-domain.prov> ;
            prof:hasArtifact <https://ogcincubator.github.io/cross-domain-model/_sources/prov/shapes.shacl> ;
            prof:hasRole role:validation ] ;
    bblocks:dependsOn <bblocks://ogc.api.records.v1.schemas.recordGeoJSON>,
        <bblocks://ogc.ogc-utils.prov> ;
    bblocks:scope <http://www.opengis.net/def/bblocks/scope/contrib> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

